BIGMODEL_API_KEY=
BIGMODEL_EMBEDDING_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_AUTO_MERGE_THRESHOLD=0.99
EMBEDDING_CANDIDATE_THRESHOLD=0.85
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DATABASE_URL=sqlite:///../data/kg_annotator.db
UPLOAD_DIR=../data/documents
PDF_PARSER=auto
MINERU_API_KEY=
MINERU_POLL_INTERVAL=5
MINERU_POLL_TIMEOUT=900
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
